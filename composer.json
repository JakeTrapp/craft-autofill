{
  "name": "jt-dev/craft-autofill",
  "description": "Turn messy input into fully populated entries in seconds.",
  "type": "craft-plugin",
  "license": "proprietary",
  "support": {
    "email": "jake.trapp02@gmail.com",
    "issues": "https://github.com/JakeTrapp/craft-autofill/issues",
    "source": "https://github.com/JakeTrapp/craft-autofill",
    "docs": "https://www.jtdevelop.com/development/plugins/autofill",
    "rss": "https://github.com/JakeTrapp/craft-autofill/releases.atom"
  },
  "require": {
    "php": ">=8.2",
    "craftcms/cms": "^5.12.1"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "jtdev\\craftautofill\\": "src/"
    }
  },
  "extra": {
    "handle": "autofill",
    "name": "Autofill",
    "developer": "JTDev",
    "documentationUrl": "https://www.jtdevelop.com/development/plugins/autofill",
    "class": "jtdev\\craftautofill\\AutofillPlugin"
  },
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G",
    "test:unit": "phpunit",
    "test:integration": "tests/integration/run",
    "test:browser": "npm run test:browser"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  },
  "archive": {
    "exclude": [
      "/vendor",
      "/node_modules",
      "/.ddev",
      "/testbench",
      "/tests",
      "/src/web/assets/cp/frontend",
      "/.env",
      "/.env.*",
      "/.phpunit.cache",
      "/phpunit.xml.dist",
      "/playwright.config.ts",
      "/package.json",
      "/package-lock.json",
      "/composer.lock",
      "/CRAFT-5-PLANNING.md",
      "/CRAFT-6-PLANNING.md",
      "/TESTING-PLANNING.md",
      "/TECHNICAL-PLAN.md",
      "/jt-develop-docs",
      "/outline.txt",
      "/.DS_Store",
      "/playwright-report",
      "/test-results",
      "/blob-report",
      "/autofill-test-volume-*"
    ]
  }
}
