{% do view.registerAssetBundle('jtdev\\craftautofill\\web\\assets\\cp\\AutofillCpAsset') %}
{% set autofillLauncherKey = 'autofill-' ~ (field.workflowHandle ?? 'missing') ~ '-' ~ (field.uid ?? field.id ?? 'sidebar') %}
{% set autofillInstanceId = autofillLauncherKey ~ '-' ~ random(2147483647) %}
{% set runtimePlugin = craft.app.plugins.getPlugin('autofill') %}
{% set runtimeWorkflow = runtimePlugin.workflowService.getByHandle(field.workflowHandle ?? '') %}
{% set canStartRun = currentUser and runtimeWorkflow and not runtimeWorkflow.archived and runtimePlugin.workflowAccess.canView(runtimeWorkflow, currentUser) and runtimePlugin.workflowAccess.can(currentUser, 'run') %}
{% set previewConfig = {
    canStart: canStartRun,
    sidebar: sidebar ?? false,
    workflowName: field.name ?: field.workflowHandle ?: 'Autofill workflow',
    selectedRunId: selectedRunId ?? null,
    autoOpenReview: autoOpenReview ?? false,
    workflowHandle: field.workflowHandle ?? '',
    elementId: element.id ?? null,
    siteId: element.siteId ?? null,
    launcherKey: autofillLauncherKey,
    testMode: testMode ?? true,
    instanceId: autofillInstanceId,
    promptPreviewActionUrl: actionUrl('autofill/workflow-run/preview'),
    startRunActionUrl: actionUrl('autofill/workflow-run/start'),
    currentRunActionUrl: actionUrl('autofill/workflow-run/current'),
    runStatusActionUrl: actionUrl('autofill/workflow-run/status'),
    regenerateRunActionUrl: actionUrl('autofill/workflow-run/regenerate'),
    cancelRunActionUrl: actionUrl('autofill/workflow-run/cancel'),
    decideRunActionUrl: actionUrl('autofill/workflow-run/decide'),
    generateSuggestionsActionUrl: actionUrl('autofill/workflow-run/generate'),
    responseNormalizeActionUrl: actionUrl('autofill/workflow-run/normalize'),
    applySuggestionActionUrl: actionUrl('autofill/workflow-run/apply'),
    iconSvgActionUrl: actionUrl('app/icon-svg'),
} %}
{% set isTestMode = testMode ?? true %}
{% set showUserPromptInput = field.showUserPromptInput ?? true %}
{% set defaultActionLabel = isTestMode ? 'Generate' : 'Autofill' %}
{% set actionButtonLabel = field.actionButtonLabel|trim ?: defaultActionLabel %}
{% set autofillDomId = autofillInstanceId %}
{% set previewConfigJson = previewConfig|json_encode %}

{% set isSidebar = sidebar ?? false %}
{% macro actions(isSidebar, actionButtonLabel, workflowName) %}
    <div class="{{ isSidebar ? 'autofill-sidebar-actions' : 'buttons' }}">
        <button type="button" class="btn{{ isSidebar ? ' small' : ' submit' }}" data-autofill-generate{% if isSidebar %} aria-label="{{ actionButtonLabel }} {{ workflowName }}"{% endif %}>{{ actionButtonLabel }}</button>
        <button type="button" class="btn{{ isSidebar ? ' small autofill-sidebar-icon' : '' }}" data-autofill-regenerate hidden aria-label="{{ isSidebar ? 'Regenerate results for {workflow}'|t('autofill', {workflow: workflowName}) : 'Regenerate results'|t('autofill') }}" title="{{ 'Regenerate results'|t('autofill') }}">
            {% if isSidebar %}<span class="cp-icon" aria-hidden="true">{{ iconSvg('arrow-rotate-right') }}</span>{% else %}{{ 'Regenerate'|t('autofill') }}{% endif %}
        </button>
        <button type="button" class="btn{{ isSidebar ? ' small autofill-sidebar-icon' : '' }}" data-autofill-cancel hidden aria-label="{{ isSidebar ? 'Dismiss run for {workflow}'|t('autofill', {workflow: workflowName}) : 'Dismiss run'|t('autofill') }}" title="{{ 'Dismiss run'|t('autofill') }}">
            {% if isSidebar %}<span class="cp-icon" aria-hidden="true">{{ iconSvg('xmark') }}</span>{% else %}{{ 'Dismiss run'|t('autofill') }}{% endif %}
        </button>
    </div>
{% endmacro %}
{% import _self as runtimeUi %}
<div
    class="autofill-runtime{{ isSidebar ? ' autofill-runtime--sidebar' : '' }}"
    data-autofill-runtime
    data-autofill-instance-id="{{ autofillInstanceId }}"
    data-autofill-config="{{ previewConfigJson|e('html_attr') }}"
    {% if isSidebar %}role="listitem"{% endif %}
>
    {% if isSidebar %}
        <div class="autofill-sidebar-row">
            <button type="button" class="autofill-sidebar-name" data-autofill-toggle aria-expanded="false" aria-controls="{{ autofillDomId }}-body" title="{{ field.name ?: field.workflowHandle }}">
                <span class="cp-icon autofill-sidebar-chevron" aria-hidden="true">{{ iconSvg('chevron-right') }}</span>
                <span class="autofill-sidebar-name-text">{{ field.name ?: field.workflowHandle ?: 'Autofill workflow' }}</span>
            </button>
            {{ runtimeUi.actions(true, isTestMode ? 'Preview'|t('app') : 'Run'|t('autofill'), field.name ?: field.workflowHandle) }}
        </div>
        <p class="autofill-sidebar-state" data-autofill-sidebar-state role="status" aria-live="polite" hidden></p>
    {% endif %}
    <div class="autofill-runtime__body"{% if isSidebar %} id="{{ autofillDomId }}-body" data-autofill-sidebar-body hidden{% endif %}>
        <div class="autofill-runtime__primary">
            {% if inboxReview ?? false %}
                <p class="autofill-sidebar-review-links"><a href="{{ url('autofill/inbox') }}">{{ 'Back to inbox'|t('autofill') }}</a>{% if nextReviewRunId ?? null %} · <a href="{{ url('autofill/inbox/' ~ nextReviewRunId) }}">{{ 'Review next item'|t('autofill') }}</a>{% endif %}</p>
            {% endif %}
            {% if isSidebar and workflowDescription|default('') %}
                <p class="autofill-sidebar-description">{{ workflowDescription|e }}</p>
            {% endif %}
            {% if showUserPromptInput %}
                <div class="field">
                    {% if isSidebar %}<div class="heading"><label for="autofill-user-prompt-{{ autofillDomId }}">{{ 'Additional instructions'|t('autofill') }}</label></div>{% endif %}
                    <div class="input ltr">
                        <textarea id="autofill-user-prompt-{{ autofillDomId }}" class="text fullwidth" rows="{{ isSidebar ? 3 : 5 }}" data-autofill-user-prompt placeholder="{{ isSidebar ? 'Optional instructions for this run'|t('autofill') : 'Type your request/context here...'|t('autofill') }}"></textarea>
                    </div>
                </div>
            {% endif %}
            {% if not isSidebar %}{{ runtimeUi.actions(false, actionButtonLabel, field.name ?: field.workflowHandle) }}{% endif %}
            <p class="autofill-runtime__status" data-autofill-run-status role="status" aria-live="polite" hidden></p>
        </div>
        {% if isTestMode %}
            <div class="field">
                <div class="heading"><label>{{ 'Built Prompt Preview'|t('autofill') }}</label></div>
                <div class="input ltr"><textarea class="text fullwidth code" rows="{{ isSidebar ? 6 : 16 }}" readonly data-autofill-preview placeholder="Preview appears here after clicking Generate."></textarea></div>
            </div>
            <div class="field">
                <div class="heading"><label for="autofill-response-input-{{ autofillDomId }}">{{ 'Test Response Input'|t('autofill') }}</label></div>
                <div class="input ltr"><textarea id="autofill-response-input-{{ autofillDomId }}" class="text fullwidth code" rows="{{ isSidebar ? 4 : 8 }}" data-autofill-response-input placeholder='[{"fieldName":"Phone Number","value":"555-123-4567"}]'></textarea></div>
            </div>
            <div class="buttons"><button type="button" class="btn" data-autofill-parse-response>{{ 'Parse + Start Review'|t('autofill') }}</button></div>
        {% endif %}
    </div>
</div>

{% include 'autofill/fields/autofill/partials/_review-modal.twig' with {
    modalInstanceId: autofillInstanceId,
} only %}

{% css %}
.autofill-runtime {
    margin-bottom: 18px;
}

.autofill-runtime__primary {
    display: grid;
    gap: 8px;
}

.autofill-runtime__primary .field {
    margin-bottom: 0;
}

.autofill-runtime__primary .buttons {
    margin-top: 0;
}

.autofill-runtime [hidden] { display: none !important; }
.autofill-sidebar { margin: 20px 0; }
.autofill-sidebar h2 {
    margin: 0;
    padding-block: 12px 8px;
    border-bottom: 1px solid var(--gray-200, #dce2e8);
}
.autofill-runtime--sidebar { margin: 0; padding: 8px 0; }
.autofill-runtime--sidebar ~ .autofill-runtime--sidebar { border-top: 1px solid var(--gray-200, #dce2e8); }
.autofill-sidebar-row { display: flex; align-items: center; gap: 8px; }
.autofill-sidebar-name { display: flex; align-items: center; gap: 7px; min-width: 0; flex: 1; padding: 5px 0; border: 0; background: transparent; color: inherit; font: inherit; font-size: 13px; font-weight: 600; text-align: start; cursor: pointer; }
.autofill-sidebar-name-text { min-width: 0; overflow-wrap: anywhere; }
.autofill-sidebar-chevron { flex: 0 0 9px; width: 9px; height: 9px; color: var(--gray-500, #647284); transition: transform .15s; }
.autofill-sidebar-chevron svg { display: block; width: 100%; height: 100%; }
.autofill-sidebar-name[aria-expanded="true"] .autofill-sidebar-chevron { transform: rotate(90deg); }
.autofill-sidebar-name:hover { color: var(--link-color, #25638d); }
.autofill-sidebar-name:focus-visible { outline: 2px solid var(--focus-color, #25638d); outline-offset: 2px; border-radius: 3px; }
.autofill-sidebar-actions { display: flex; align-items: center; gap: 4px; flex-shrink: 0; }
.autofill-sidebar-actions .btn { min-height: 30px; padding: 5px 9px; font-size: 12px; }
.autofill-sidebar-actions [data-autofill-generate]:not(.submit, :disabled) {
    --button-bg: var(--teal-700, #0f766e);
    --button-bg--hover: var(--teal-800, #115e59);
    --button-bg--active: var(--teal-900, #134e4a);
    color: #fff;
}
.autofill-sidebar-description { margin: 0; font-size: 12px; line-height: 1.5; white-space: pre-wrap; overflow-wrap: anywhere; }
.autofill-sidebar-description + .field { padding-top: 8px; }
.autofill-sidebar-actions .autofill-sidebar-icon { width: 27px; padding: 5px; background: transparent; box-shadow: none; }
.autofill-sidebar-icon .cp-icon { display: block; width: 13px; height: 13px; }
.autofill-sidebar-icon svg { width: 100%; height: 100%; }
.autofill-sidebar-actions .autofill-sidebar-icon:hover { background: var(--gray-150, #e8edf2); }
.autofill-runtime--sidebar .autofill-runtime__body { padding: 12px 0 2px 16px; }
.autofill-runtime--sidebar .autofill-runtime__body > .field { margin-top: 14px; }
.autofill-runtime--sidebar .autofill-runtime__body .field { margin: 0 !important; }
.autofill-runtime--sidebar .autofill-runtime__body .heading label { font-size: 12px; }
.autofill-sidebar-state { font-size: 11px; color: var(--gray-500, #647284); margin: 3px 0 0 16px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.autofill-runtime--sidebar[data-autofill-run-state="failed"] .autofill-sidebar-state { color: var(--error-color, #b32323); }
.autofill-sidebar-review-links, .autofill-runtime--sidebar .autofill-runtime__status { font-size: 12px; line-height: 1.5; }
.autofill-sidebar-review-links { margin: 0 0 8px; }
@media (prefers-reduced-motion: reduce) { .autofill-sidebar-chevron { transition: none; } }

.autofill-review-modal-backdrop {
    position: fixed;
    inset: 0;
    background: transparent;
    z-index: 9997;
    pointer-events: none;
}

.autofill-review-modal-backdrop::before {
    content: "";
    position: fixed;
    top: var(--autofill-spotlight-top, -1px);
    left: var(--autofill-spotlight-left, -1px);
    width: var(--autofill-spotlight-width, 0);
    height: var(--autofill-spotlight-height, 0);
    border-radius: 8px;
    box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.35);
    pointer-events: none;
}

.autofill-review-modal-backdrop[hidden],
.autofill-review-modal[hidden] {
    display: none;
}

.autofill-review-modal {
    display: block;
    color: #2f3a47;
}

.autofill-review-modal::backdrop {
    background: transparent;
}

.autofill-review-modal::part(panel)::backdrop {
    background: transparent;
}

.autofill-review-modal::part(panel) {
    width: min(720px, calc(100vw - 32px));
    max-width: calc(100vw - 32px);
    max-height: var(--autofill-review-max-height, calc(100vh - 48px));
    inset: var(--autofill-review-top, 96px) 0 auto;
    margin: 0 auto;
    transform: none;
    padding: 0;
}

.autofill-review-modal.is-inspecting::part(panel) {
    inset: auto 0 12px;
}

.autofill-review-modal.is-inspecting::part(body) {
    display: none;
}

.autofill-review-modal.is-inspecting .autofill-review-modal__header {
    padding-block: 8px;
}

.autofill-review-modal.is-inspecting .autofill-review-modal__buttons {
    padding-block: 0;
}

/* Leave room to scroll even the last field above the docked review controls. */
body:has(.autofill-review-modal.is-inspecting:not([hidden]))::after {
    content: "";
    display: block;
    block-size: 10rem;
}

.autofill-review-modal__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 20px 12px;
}

.autofill-review-modal__title {
    margin: 0;
    font-size: 20px;
    line-height: 1.25;
    font-weight: 600;
    color: #2f3a47;
}

.autofill-review-modal__progress {
    display: flex;
    align-items: baseline;
    gap: 12px;
    min-width: 0;
    font-size: 12px;
    line-height: 1.3;
    white-space: nowrap;
}

.autofill-review-modal__summary {
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #67778a;
}

.autofill-review-modal__counter {
    margin: 0;
    flex-shrink: 0;
    font-weight: 700;
    color: #2f3a47;
}

.autofill-review-modal__body {
    display: grid;
    gap: 10px;
    padding: 8px 20px;
    overflow-wrap: anywhere;
}

.autofill-review-modal__loading {
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 20px 0 10px;
}

.autofill-review-modal__loading[hidden] {
    display: none !important;
}

.autofill-review-modal__spinner {
    width: 26px;
    height: 26px;
    border-radius: 999px;
    border: 3px solid #d6deea;
    border-top-color: #3b82f6;
    animation: autofillSpin 0.85s linear infinite;
}

.autofill-review-modal__loading-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.35;
    color: #4c5d70;
}

.autofill-review-modal.is-loading .autofill-review-modal__body,
.autofill-review-modal.is-loading .autofill-review-modal__buttons {
    display: none;
}

.autofill-review-modal__field {
    padding: 2px 0;
    font-size: 16px;
    line-height: 1.35;
    font-weight: 600;
    color: #364656;
}

.autofill-review-modal [data-autofill-accept]:disabled { opacity: .6; background: #e3e7ec; color: #536174; cursor: not-allowed; }
[data-autofill-review-raw] { margin: 12px 0; font-size: 12px; }
[data-autofill-review-raw] summary { cursor: pointer; font-weight: 600; }
[data-autofill-review-raw-value] { max-height: 180px; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; background: #f6f7f9; border: 1px solid #dce2e8; border-radius: 4px; padding: 10px; margin-top: 6px; }
.autofill-review-modal__errors {
    margin: -2px 0 0;
    font-size: 13px;
    line-height: 1.35;
    color: #b42318;
}

.autofill-review-modal [data-autofill-review-editor] textarea {
    min-height: 88px;
}

.autofill-review-icon {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 10px 12px;
    border: 1px solid #c8d2e0;
    border-radius: 8px;
    background: #f8fafc;
}

.autofill-review-icon__glyph {
    display: inline-flex;
    flex: 0 0 56px;
    align-items: center;
    justify-content: center;
    min-width: 56px;
    width: 56px;
    height: 42px;
    border-radius: 10px;
    background: #fff;
    border: 1px solid #d8e1ec;
    color: #2f3a47;
}

.autofill-review-icon__glyph svg {
    width: 20px;
    height: 20px;
}

.autofill-review-icon__meta {
    min-width: 0;
}

.autofill-review-icon__name {
    font-size: 13px !important;
}

.autofill-review-icon__hint {
    margin: 4px 0 0;
    font-size: 12px;
    line-height: 1.35;
    color: #67778a;
}

.autofill-review-modal--richtext {
    --autofill-review-width: min(980px, calc(100vw - 32px));
}

.autofill-review-modal--table {
    --autofill-review-width: min(1080px, calc(100vw - 32px));
}

.autofill-review-modal--richtext::part(panel),
.autofill-review-modal--table::part(panel) {
    width: var(--autofill-review-width);
}

.autofill-review-modal--richtext [data-autofill-review-editor] textarea {
    min-height: 320px;
}

.autofill-review-richtext-editor {
    min-height: 320px;
    max-height: 56vh;
    overflow: auto;
    padding: 12px;
    border: 1px solid #c8d2e0;
    border-radius: 6px;
    background: #fff;
    line-height: 1.5;
    font-size: 14px;
}

.autofill-review-richtext-editor:focus {
    outline: 2px solid #3b82f6;
    outline-offset: 1px;
}

.autofill-review-richtext-editor > :first-child {
    margin-top: 0;
}

.autofill-review-richtext-editor > :last-child {
    margin-bottom: 0;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-datetime {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-range {
    display: grid;
    gap: 10px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-range__number {
    display: inline-flex;
    align-items: center;
    gap: 10px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-range__number .field {
    margin: 0;
    min-width: 140px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-range__suffix {
    color: #67778a;
    font-size: 13px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-money {
    display: grid;
    gap: 8px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-money__currency {
    font-size: 12px;
    font-weight: 600;
    color: #52667a;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-money__hint {
    margin: 0;
    font-size: 12px;
    line-height: 1.35;
    color: #67778a;
}

.autofill-review-link {
    display: grid;
    gap: 8px;
    padding: 12px 14px;
    border: 1px solid #c8d2e0;
    border-radius: 10px;
    background: #fff;
}

.autofill-review-link__header {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
}

.autofill-review-link__type,
.autofill-review-link__target {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    color: #52667a;
    background: #eef4fb;
}

.autofill-review-link__target {
    background: #f4f7fb;
    color: #67778a;
}

.autofill-review-link__destination {
    font-size: 18px;
    line-height: 1.3;
    font-weight: 600;
    color: #243447;
    word-break: break-word;
}

.autofill-review-link__supporting {
    display: grid;
    gap: 4px;
}

.autofill-review-link__url {
    font-size: 13px;
    color: #52667a;
    word-break: break-all;
}

.autofill-review-link__meta {
    font-size: 13px;
    color: #67778a;
    word-break: break-word;
}

.autofill-review-link__extras {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.autofill-review-link__extra {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #67778a;
    word-break: break-word;
}

.autofill-review-link__extra-prefix {
    font-weight: 600;
    color: #52667a;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-button-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-button-group .btn.active {
    background: #0f172a;
    color: #fff;
    border-color: #0f172a;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-seomatic {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-seomatic__field {
    display: grid;
    gap: 4px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-seomatic__label {
    font-size: 12px;
    font-weight: 600;
    color: #364656;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-seomatic .field {
    margin: 0;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-seomatic textarea {
    field-sizing: content;
}

.autofill-review-table {
    display: grid;
    gap: 10px;
}

.autofill-review-table__frame {
    max-height: 52vh;
    overflow: auto;
    padding: 10px;
    border: 1px solid #c8d2e0;
    border-radius: 8px;
    background: #f8fafc;
}

.autofill-review-table__frame table {
    margin-bottom: 0;
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
}

.autofill-review-table__frame thead th {
    position: sticky;
    top: 0;
    z-index: 1;
}

.autofill-review-table__hint {
    margin: 0;
    font-size: 12px;
    line-height: 1.35;
    color: #67778a;
}

.autofill-review-table__empty {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
    color: #67778a;
}
{% include 'autofill/fields/autofill/assets/input/review/styles/addresses.css.twig' %}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-related__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-related-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 8px;
    border: 1px solid #c8d2e0;
    border-radius: 999px;
    background: #f8fafc;
    max-width: 100%;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-related-chip__label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: min(420px, 62vw);
}

.autofill-review-modal [data-autofill-review-editor] .autofill-related-chip__remove {
    border: 0;
    background: transparent;
    color: #64748b;
    cursor: pointer;
    font-size: 16px;
    line-height: 1;
    padding: 0;
}

.autofill-review-modal__buttons {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    width: 100%;
    padding-block: 4px;
}

.autofill-review-modal__buttons [data-autofill-close] {
    margin-left: auto;
}

.autofill-focus-highlight {
    position: relative;
    z-index: 9998;
    pointer-events: none;
}

@keyframes autofillSpin {
    to {
        transform: rotate(360deg);
    }
}
{% endcss %}

