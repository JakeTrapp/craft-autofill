{% do view.registerAssetBundle('jtdev\\craftautofill\\web\\assets\\cp\\AutofillCpAsset') %}
{% set autofillLauncherKey = 'autofill-' ~ (field.workflowHandle ?? 'missing') ~ '-' ~ (field.uid ?? field.id ?? 'sidebar') %}
{% set autofillInstanceId = autofillLauncherKey ~ '-' ~ random(2147483647) %}
{% set previewConfig = {
    workflowHandle: field.workflowHandle ?? '',
    elementId: element.id ?? null,
    siteId: element.siteId ?? null,
    launcherKey: autofillLauncherKey,
    testMode: testMode ?? true,
    instanceId: autofillInstanceId,
    promptPreviewActionUrl: actionUrl('autofill/workflow-run/preview'),
    generateSuggestionsActionUrl: actionUrl('autofill/workflow-run/generate'),
    responseNormalizeActionUrl: actionUrl('autofill/workflow-run/normalize'),
    applySuggestionActionUrl: actionUrl('autofill/workflow-run/apply'),
    iconSvgActionUrl: actionUrl('app/icon-svg'),
} %}
{% set isTestMode = testMode ?? true %}
{% set showUserPromptInput = field.showUserPromptInput ?? true %}
{% set defaultActionLabel = isTestMode ? 'Generate' : 'Autofill' %}
{% set actionButtonLabel = field.actionButtonLabel|trim ?: defaultActionLabel %}
{% set autofillDomId = autofillInstanceId %}
{% set previewConfigJson = previewConfig|json_encode %}

{% if sidebar ?? false %}
    <h2 class="autofill-runtime__workflow-name">{{ field.name ?: field.workflowHandle ?: 'Autofill workflow' }}</h2>
{% endif %}

<div
    class="autofill-runtime"
    data-autofill-runtime
    data-autofill-instance-id="{{ autofillInstanceId }}"
    data-autofill-config="{{ previewConfigJson|e('html_attr') }}"
>
    <div class="autofill-runtime__primary">
        {% if showUserPromptInput %}
            <div class="field">
                <div class="input ltr">
                    <textarea
                        id="autofill-user-prompt-{{ autofillDomId }}"
                        class="text fullwidth"
                        rows="5"
                        data-autofill-user-prompt
                        placeholder="Type your request/context here..."
                    ></textarea>
                </div>
            </div>
        {% endif %}

        <div class="buttons">
            <button type="button" class="btn submit" data-autofill-generate>{{ actionButtonLabel }}</button>
        </div>
        <p class="autofill-runtime__status" data-autofill-run-status role="status" aria-live="polite" hidden></p>
    </div>

    {% if isTestMode %}
        <div class="field">
            <div class="heading">
                <label>Built Prompt Preview</label>
            </div>
            <div class="input ltr">
                <textarea class="text fullwidth code" rows="16" readonly data-autofill-preview placeholder="Preview appears here after clicking Generate."></textarea>
            </div>
        </div>

        <div class="field">
            <div class="heading">
                <label for="autofill-response-input-{{ autofillDomId }}">Test Response Input</label>
                <div class="instructions">
                    <p>Paste AI JSON response here, then click Parse + Start Review.</p>
                </div>
            </div>
            <div class="input ltr">
                <textarea
                    id="autofill-response-input-{{ autofillDomId }}"
                    class="text fullwidth code"
                    rows="8"
                    data-autofill-response-input
                    placeholder='[{"fieldName":"Phone Number","value":"555-123-4567"}]'
                ></textarea>
            </div>
        </div>

        <div class="buttons">
            <button type="button" class="btn" data-autofill-parse-response>Parse + Start Review</button>
        </div>
    {% endif %}

</div>

{% include 'autofill/fields/autofill/partials/_review-modal.twig' with {
    modalInstanceId: autofillInstanceId,
} only %}

{% css %}
.autofill-runtime {
    margin-bottom: 18px;
}

.autofill-runtime__primary {
    display: grid;
    gap: 8px;
}

.autofill-runtime__primary .field {
    margin-bottom: 0;
}

.autofill-runtime__primary .buttons {
    margin-top: 0;
}

.autofill-review-modal-backdrop {
    position: fixed;
    inset: 0;
    background: transparent;
    z-index: 9997;
}

.autofill-review-modal-backdrop::before {
    content: "";
    position: fixed;
    top: var(--autofill-spotlight-top, -1px);
    left: var(--autofill-spotlight-left, -1px);
    width: var(--autofill-spotlight-width, 0);
    height: var(--autofill-spotlight-height, 0);
    border-radius: 8px;
    box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.35);
    pointer-events: none;
}

.autofill-review-modal-backdrop[hidden],
.autofill-review-modal[hidden] {
    display: none;
}

.autofill-review-modal {
    display: block;
    color: #2f3a47;
}

.autofill-review-modal::backdrop {
    background: transparent;
}

.autofill-review-modal::part(panel)::backdrop {
    background: transparent;
}

.autofill-review-modal::part(panel) {
    width: min(720px, calc(100vw - 32px));
    max-width: calc(100vw - 32px);
    max-height: var(--autofill-review-max-height, calc(100vh - 48px));
    inset: var(--autofill-review-top, 96px) 0 auto;
    margin: 0 auto;
    transform: none;
    padding: 0;
}

.autofill-review-modal__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 20px 12px;
}

.autofill-review-modal__title {
    margin: 0;
    font-size: 20px;
    line-height: 1.25;
    font-weight: 600;
    color: #2f3a47;
}

.autofill-review-modal__counter {
    margin: 0;
    font-size: 12px;
    line-height: 1.3;
    font-weight: 500;
    color: #67778a;
}

.autofill-review-modal__body {
    display: grid;
    gap: 10px;
    max-height: calc(100vh - 210px);
    overflow: auto;
    padding: 8px 20px;
}

.autofill-review-modal__loading {
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 20px 0 10px;
}

.autofill-review-modal__loading[hidden] {
    display: none !important;
}

.autofill-review-modal__spinner {
    width: 26px;
    height: 26px;
    border-radius: 999px;
    border: 3px solid #d6deea;
    border-top-color: #3b82f6;
    animation: autofillSpin 0.85s linear infinite;
}

.autofill-review-modal__loading-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.35;
    color: #4c5d70;
}

.autofill-review-modal.is-loading .autofill-review-modal__body,
.autofill-review-modal.is-loading .autofill-review-modal__buttons {
    display: none;
}

.autofill-review-modal__field {
    padding: 2px 0;
    font-size: 16px;
    line-height: 1.35;
    font-weight: 600;
    color: #364656;
}

.autofill-review-modal [data-autofill-accept]:disabled { opacity: .6; background: #e3e7ec; color: #536174; cursor: not-allowed; }
[data-autofill-review-raw] { margin: 12px 0; font-size: 12px; }
[data-autofill-review-raw] summary { cursor: pointer; font-weight: 600; }
[data-autofill-review-raw-value] { max-height: 180px; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; background: #f6f7f9; border: 1px solid #dce2e8; border-radius: 4px; padding: 10px; margin-top: 6px; }
.autofill-review-modal__errors {
    margin: -2px 0 0;
    font-size: 13px;
    line-height: 1.35;
    color: #b42318;
}

.autofill-review-modal [data-autofill-review-editor] textarea {
    min-height: 88px;
}

.autofill-review-icon {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 10px 12px;
    border: 1px solid #c8d2e0;
    border-radius: 8px;
    background: #f8fafc;
}

.autofill-review-icon__glyph {
    display: inline-flex;
    flex: 0 0 56px;
    align-items: center;
    justify-content: center;
    min-width: 56px;
    width: 56px;
    height: 42px;
    border-radius: 10px;
    background: #fff;
    border: 1px solid #d8e1ec;
    color: #2f3a47;
}

.autofill-review-icon__glyph svg {
    width: 20px;
    height: 20px;
}

.autofill-review-icon__meta {
    min-width: 0;
}

.autofill-review-icon__name {
    font-size: 13px !important;
}

.autofill-review-icon__hint {
    margin: 4px 0 0;
    font-size: 12px;
    line-height: 1.35;
    color: #67778a;
}

.autofill-review-modal--richtext {
    --autofill-review-width: min(980px, calc(100vw - 32px));
}

.autofill-review-modal--table {
    --autofill-review-width: min(1080px, calc(100vw - 32px));
}

.autofill-review-modal--richtext::part(panel),
.autofill-review-modal--table::part(panel) {
    width: var(--autofill-review-width);
}

.autofill-review-modal--richtext [data-autofill-review-editor] textarea {
    min-height: 320px;
}

.autofill-review-richtext-editor {
    min-height: 320px;
    max-height: 56vh;
    overflow: auto;
    padding: 12px;
    border: 1px solid #c8d2e0;
    border-radius: 6px;
    background: #fff;
    line-height: 1.5;
    font-size: 14px;
}

.autofill-review-richtext-editor:focus {
    outline: 2px solid #3b82f6;
    outline-offset: 1px;
}

.autofill-review-richtext-editor > :first-child {
    margin-top: 0;
}

.autofill-review-richtext-editor > :last-child {
    margin-bottom: 0;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-datetime {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-range {
    display: grid;
    gap: 10px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-range__number {
    display: inline-flex;
    align-items: center;
    gap: 10px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-range__number .field {
    margin: 0;
    min-width: 140px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-range__suffix {
    color: #67778a;
    font-size: 13px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-money {
    display: grid;
    gap: 8px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-money__currency {
    font-size: 12px;
    font-weight: 600;
    color: #52667a;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-money__hint {
    margin: 0;
    font-size: 12px;
    line-height: 1.35;
    color: #67778a;
}

.autofill-review-link {
    display: grid;
    gap: 8px;
    padding: 12px 14px;
    border: 1px solid #c8d2e0;
    border-radius: 10px;
    background: #fff;
}

.autofill-review-link__header {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
}

.autofill-review-link__type,
.autofill-review-link__target {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    color: #52667a;
    background: #eef4fb;
}

.autofill-review-link__target {
    background: #f4f7fb;
    color: #67778a;
}

.autofill-review-link__destination {
    font-size: 18px;
    line-height: 1.3;
    font-weight: 600;
    color: #243447;
    word-break: break-word;
}

.autofill-review-link__supporting {
    display: grid;
    gap: 4px;
}

.autofill-review-link__url {
    font-size: 13px;
    color: #52667a;
    word-break: break-all;
}

.autofill-review-link__meta {
    font-size: 13px;
    color: #67778a;
    word-break: break-word;
}

.autofill-review-link__extras {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.autofill-review-link__extra {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #67778a;
    word-break: break-word;
}

.autofill-review-link__extra-prefix {
    font-weight: 600;
    color: #52667a;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-button-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-button-group .btn.active {
    background: #0f172a;
    color: #fff;
    border-color: #0f172a;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-seomatic {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-seomatic__field {
    display: grid;
    gap: 4px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-seomatic__label {
    font-size: 12px;
    font-weight: 600;
    color: #364656;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-seomatic .field {
    margin: 0;
}

.autofill-review-table {
    display: grid;
    gap: 10px;
}

.autofill-review-table__frame {
    max-height: 52vh;
    overflow: auto;
    padding: 10px;
    border: 1px solid #c8d2e0;
    border-radius: 8px;
    background: #f8fafc;
}

.autofill-review-table__frame table {
    margin-bottom: 0;
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
}

.autofill-review-table__frame thead th {
    position: sticky;
    top: 0;
    z-index: 1;
}

.autofill-review-table__hint {
    margin: 0;
    font-size: 12px;
    line-height: 1.35;
    color: #67778a;
}

.autofill-review-table__empty {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
    color: #67778a;
}
{% include 'autofill/fields/autofill/assets/input/review/styles/addresses.css.twig' %}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-related__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-related-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 8px;
    border: 1px solid #c8d2e0;
    border-radius: 999px;
    background: #f8fafc;
    max-width: 100%;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-related-chip__label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: min(420px, 62vw);
}

.autofill-review-modal [data-autofill-review-editor] .autofill-related-chip__remove {
    border: 0;
    background: transparent;
    color: #64748b;
    cursor: pointer;
    font-size: 16px;
    line-height: 1;
    padding: 0;
}

.autofill-review-modal__buttons {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    padding: 12px 20px 18px;
}

.autofill-review-modal__buttons [data-autofill-close] {
    margin-left: auto;
}

.autofill-focus-highlight {
    position: relative;
    z-index: 9998;
    pointer-events: none;
}

@keyframes autofillSpin {
    to {
        transform: rotate(360deg);
    }
}
{% endcss %}

{% js %}
{% include 'autofill/fields/autofill/assets/input/api.js.twig' %}
{% include 'autofill/fields/autofill/assets/input/field/locator.js.twig' %}
{% include 'autofill/fields/autofill/assets/input/field/interaction.js.twig' %}
{% include 'autofill/fields/autofill/assets/input/review/renderers.js.twig' %}
{% include 'autofill/fields/autofill/assets/input/review/modal.js.twig' %}
{% include 'autofill/fields/autofill/assets/input/review/suggestion-flow.js.twig' %}
{% include 'autofill/fields/autofill/assets/input/runtime.js.twig' %}
{% endjs %}
