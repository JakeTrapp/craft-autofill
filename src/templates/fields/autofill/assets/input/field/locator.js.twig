(() => {
    // Finds Craft field inputs and checks whether they already contain values.
    window.AutofillInputRuntime = window.AutofillInputRuntime || {};
    const runtime = window.AutofillInputRuntime;

    const escapeHandle = (handle) => (
        window.CSS && typeof window.CSS.escape === 'function'
            ? window.CSS.escape(handle)
            : handle.replace(/"/g, '\\"')
    );

    const pickBest = (nodes) => {
        const list = Array.from(nodes).filter((node) => node instanceof HTMLElement);
        if (!list.length) {
            return null;
        }
        const visibleEnabled = list.find((node) => {
            const style = window.getComputedStyle(node);
            const hidden = style.display === 'none' || style.visibility === 'hidden';
            const disabled = 'disabled' in node ? Boolean(node.disabled) : false;
            return !hidden && !disabled;
        });
        return visibleEnabled || list[0] || null;
    };

    const fieldContainerForHandle = (escapedHandle, root = document) => {
        const fieldContainer = root.querySelector(
            `[data-attribute="${escapedHandle}"], #fields-${escapedHandle}-field`
        );

        return fieldContainer instanceof HTMLElement ? fieldContainer : null;
    };

    const isSeomaticFieldContainer = (fieldContainer) => {
        if (!(fieldContainer instanceof HTMLElement)) {
            return false;
        }

        const dataType = String(fieldContainer.dataset.type || '').toLowerCase();
        return dataType.includes('seomatic') || dataType.includes('seosettings');
    };

    const bestInputInFieldContainer = (fieldContainer) => (
        pickBest(fieldContainer.querySelectorAll(
            'input[type="text"], input[type="tel"], input[type="number"], textarea, select, input:not([type="hidden"])'
        ))
    );

    const closestSeomaticFieldContainer = (input) => {
        let cursor = input instanceof HTMLElement ? input : null;
        while (cursor) {
            if (isSeomaticFieldContainer(cursor)) {
                return cursor;
            }

            cursor = cursor.parentElement;
        }

        return null;
    };

    runtime.findFieldInputByHandle = (handle, root = document) => {
        const escaped = escapeHandle(handle);
        const base = `[name="fields[${escaped}]"]`;
        const nestedBase = `[name^="fields[${escaped}]["]`;
        const fieldContainer = fieldContainerForHandle(escaped, root);
        const nativeCandidates = [
            `textarea[name="${escaped}"]`,
            `select[name="${escaped}"]`,
            `input[type="text"][name="${escaped}"]`,
            `input[type="tel"][name="${escaped}"]`,
            `input[type="number"][name="${escaped}"]`,
            `input[type="checkbox"][name="${escaped}"]`,
            `input[name="${escaped}"]`,
            `textarea[name^="${escaped}["]`,
            `select[name^="${escaped}["]`,
            `input[name^="${escaped}["]`,
            `#${escaped}`,
        ];

        const primaryMatch = (
            pickBest(root.querySelectorAll(`textarea${base}`)) ||
            pickBest(root.querySelectorAll(`select${base}`)) ||
            pickBest(root.querySelectorAll(`input[type="text"]${base}`)) ||
            pickBest(root.querySelectorAll(`input[type="tel"]${base}`)) ||
            pickBest(root.querySelectorAll(`input[type="number"]${base}`)) ||
            pickBest(root.querySelectorAll(`input[type="checkbox"]${base}`)) ||
            pickBest(root.querySelectorAll(`input${base}`)) ||
            pickBest(root.querySelectorAll(nativeCandidates.join(', '))) ||
            null
        );

        if (primaryMatch) {
            return primaryMatch;
        }

        if (isSeomaticFieldContainer(fieldContainer)) {
            return bestInputInFieldContainer(fieldContainer);
        }

        // Fallback for fields that use nested names such as fields[handle][value].
        const nestedMatch = (
            pickBest(root.querySelectorAll(`textarea${nestedBase}`)) ||
            pickBest(root.querySelectorAll(`select${nestedBase}`)) ||
            pickBest(root.querySelectorAll(`input[type="text"]${nestedBase}`)) ||
            pickBest(root.querySelectorAll(`input[type="tel"]${nestedBase}`)) ||
            pickBest(root.querySelectorAll(`input[type="number"]${nestedBase}`)) ||
            pickBest(root.querySelectorAll(`input[type="checkbox"]${nestedBase}`)) ||
            pickBest(root.querySelectorAll(`input${nestedBase}`)) ||
            null
        );

        if (nestedMatch) {
            return nestedMatch;
        }

        // Last-resort fallback by Craft field container markup.
        if (!(fieldContainer instanceof HTMLElement)) {
            return null;
        }

        return bestInputInFieldContainer(fieldContainer);
    };

    runtime.findSplitDateTimeInputsByHandle = (handle, root = document) => {
        const escaped = escapeHandle(handle);
        const candidates = [
            {
                date: `input[name="fields[${escaped}][date]"]`,
                time: `input[name="fields[${escaped}][time]"]`,
            },
            {
                date: `input[name="${escaped}[date]"]`,
                time: `input[name="${escaped}[time]"]`,
            },
        ];

        for (const pair of candidates) {
            const dateInput = root.querySelector(pair.date);
            const timeInput = root.querySelector(pair.time);
            if (dateInput instanceof HTMLInputElement || timeInput instanceof HTMLInputElement) {
                return {
                    date: dateInput instanceof HTMLInputElement ? dateInput : null,
                    time: timeInput instanceof HTMLInputElement ? timeInput : null,
                };
            }
        }

        return { date: null, time: null };
    };

    runtime.getInteractionAnchor = (input) => {
        if (!(input instanceof HTMLElement)) {
            return input;
        }
        const seomaticFieldContainer = closestSeomaticFieldContainer(input);
        if (seomaticFieldContainer instanceof HTMLElement) {
            return seomaticFieldContainer;
        }

        return (
            input.closest('.field') ||
            input.closest('.input') ||
            input.closest('.select') ||
            input
        );
    };

    runtime.hasMeaningfulExistingValue = (handle, root = document) => {
        const splitDateTime = runtime.findSplitDateTimeInputsByHandle(handle, root);
        if (splitDateTime.date || splitDateTime.time) {
            const dateValue = splitDateTime.date instanceof HTMLInputElement ? String(splitDateTime.date.value || '').trim() : '';
            const timeValue = splitDateTime.time instanceof HTMLInputElement ? String(splitDateTime.time.value || '').trim() : '';
            return dateValue !== '' || timeValue !== '';
        }

        const input = runtime.findFieldInputByHandle(handle, root);
        if (!(input instanceof HTMLElement)) {
            return false;
        }

        if (input instanceof HTMLInputElement && input.type === 'checkbox') {
            return input.checked;
        }

        if (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement || input instanceof HTMLSelectElement) {
            return String(input.value || '').trim() !== '';
        }

        return false;
    };
})();
