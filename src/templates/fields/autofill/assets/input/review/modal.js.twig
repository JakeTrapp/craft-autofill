(() => {
    // Manages the Twig-rendered suggestion review modal and its navigation controls.
    window.AutofillInputRuntime = window.AutofillInputRuntime || {};
    const runtime = window.AutofillInputRuntime;

    runtime.createReviewModal = ({ applySuggestion, rejectSuggestion, focusMatchedField, instanceId, fieldRoot = document }) => {
        let suggestions = [];
        let currentIndex = 0;
        let isLoading = false;
        let wantsOpen = false;
        let correctionMade = false;
        let spotlightAnchor = null;
        let spotlightFrame = null;
        const instanceIdAttr = String(instanceId || '').trim();

        const byField = (selector) => {
            if (instanceIdAttr === '') {
                return document.querySelector(selector);
            }
            return document.querySelector(`${selector}[data-autofill-instance-id="${instanceIdAttr}"]`);
        };

        const modalState = {
            backdrop: byField('[data-autofill-review-backdrop]'),
            modal: byField('[data-autofill-review-modal]'),
            status: null,
            loading: null,
            loadingText: null,
            body: null,
            buttons: null,
            errors: null,
            field: null,
            editor: null,
            inspect: null,
        };

        const setModalDisplayMode = (mode) => {
            if (!(modalState.modal instanceof HTMLElement)) {
                return;
            }

            const normalized = String(mode || '').trim().toLowerCase();
            modalState.modal.classList.remove('autofill-review-modal--richtext', 'autofill-review-modal--table');
            if (normalized === 'richtext') {
                modalState.modal.classList.add('autofill-review-modal--richtext');
                return;
            }

            if (normalized === 'table') {
                modalState.modal.classList.add('autofill-review-modal--table');
            }
        };

        if (modalState.modal instanceof HTMLElement) {
            modalState.status = modalState.modal.querySelector('[data-autofill-review-status]');
            modalState.loading = modalState.modal.querySelector('[data-autofill-review-loading]');
            modalState.loadingText = modalState.modal.querySelector('[data-autofill-review-loading-text]');
            modalState.body = modalState.modal.querySelector('.autofill-review-modal__body');
            modalState.buttons = modalState.modal.querySelector('.autofill-review-modal__buttons');
            modalState.errors = modalState.modal.querySelector('[data-autofill-review-errors]');
            modalState.field = modalState.modal.querySelector('[data-autofill-review-field]');
            modalState.editor = modalState.modal.querySelector('[data-autofill-review-editor]');
            modalState.inspect = modalState.modal.querySelector('[data-autofill-inspect]');
        }

        const hoistModalToBody = () => {
            if (modalState.backdrop instanceof HTMLElement && modalState.backdrop.parentElement !== document.body) {
                document.body.appendChild(modalState.backdrop);
            }
            if (modalState.modal instanceof HTMLElement && modalState.modal.parentElement !== document.body) {
                document.body.appendChild(modalState.modal);
            }
        };

        hoistModalToBody();

        if (modalState.modal instanceof HTMLElement) {
            modalState.modal.addEventListener('pk-hide', (event) => {
                if (isLoading) event.preventDefault();
            });
            modalState.modal.addEventListener('pk-open-change', (event) => {
                if (event.detail?.open === false && wantsOpen && !isLoading) {
                    wantsOpen = false;
                    finishReview();
                }
            });
        }

        const setInspecting = (inspecting) => {
            modalState.modal?.classList.toggle('is-inspecting', inspecting);
            if (modalState.inspect instanceof HTMLElement) {
                modalState.inspect.setAttribute('aria-expanded', String(!inspecting));
                modalState.inspect.textContent = inspecting ? modalState.inspect.dataset.suggestionLabel : modalState.inspect.dataset.inspectLabel;
            }
            if (!inspecting && spotlightAnchor) placeReviewPanel(spotlightAnchor);
            queueSpotlightRefresh();
        };

        const teardown = () => {
            wantsOpen = false;
            if (modalState.backdrop instanceof HTMLElement) {
                modalState.backdrop.hidden = true;
            }
            if (modalState.modal instanceof HTMLElement) {
                if (typeof modalState.modal.hide === 'function') {
                    modalState.modal.hide('api');
                }
                modalState.modal.hidden = true;
            }
            spotlightAnchor = null;
            setInspecting(false);
            if (spotlightFrame !== null) {
                window.cancelAnimationFrame(spotlightFrame);
                spotlightFrame = null;
            }
            setModalDisplayMode('');
            setLoadingState(false);
            if (modalState.status instanceof HTMLElement) {
                modalState.status.textContent = '';
            }
            if (modalState.loadingText instanceof HTMLElement) {
                modalState.loadingText.textContent = 'Waiting for response from AI...';
            }
            if (modalState.errors instanceof HTMLElement) {
                modalState.errors.textContent = '';
                modalState.errors.hidden = true;
            }
            if (modalState.field instanceof HTMLElement) {
                modalState.field.textContent = '';
            }
            if (modalState.editor instanceof HTMLElement) {
                modalState.editor.innerHTML = '';
            }
            if (typeof runtime.clearFieldHighlight === 'function') {
                runtime.clearFieldHighlight();
            }
            isLoading = false;
        };

        const finishReview = ({ reloadPage = false } = {}) => {
            suggestions = [];
            currentIndex = 0;
            teardown();

            if (reloadPage) {
                window.location.reload();
            }
        };

        const show = () => {
            wantsOpen = true;
            if (modalState.backdrop instanceof HTMLElement) {
                modalState.backdrop.hidden = false;
            }
            if (modalState.modal instanceof HTMLElement) {
                modalState.modal.hidden = false;
                const openDialog = () => {
                    if (wantsOpen && modalState.modal instanceof HTMLElement && !modalState.modal.hidden && typeof modalState.modal.show === 'function') {
                        modalState.modal.show('api');
                    }
                };
                if (typeof modalState.modal.show === 'function') openDialog();
                else if (window.customElements?.whenDefined) window.customElements.whenDefined('pk-dialog').then(openDialog);
            }
        };

        const clearSpotlightStyles = () => {
            if (!(modalState.backdrop instanceof HTMLElement)) {
                return;
            }

            [
                '--autofill-spotlight-top',
                '--autofill-spotlight-left',
                '--autofill-spotlight-width',
                '--autofill-spotlight-height',
            ].forEach((property) => {
                modalState.backdrop.style.removeProperty(property);
            });
        };

        const clearSpotlight = () => {
            spotlightAnchor = null;
            if (spotlightFrame !== null) {
                window.cancelAnimationFrame(spotlightFrame);
                spotlightFrame = null;
            }
            clearSpotlightStyles();
        };

        const setSpotlightForAnchor = (anchor) => {
            if (!(modalState.backdrop instanceof HTMLElement) || !(anchor instanceof HTMLElement)) {
                clearSpotlight();
                return;
            }

            const rect = anchor.getBoundingClientRect();
            if (
                rect.bottom <= 0 ||
                rect.right <= 0 ||
                rect.top >= window.innerHeight ||
                rect.left >= window.innerWidth
            ) {
                clearSpotlightStyles();
                return;
            }

            const padding = 8;
            const top = Math.max(0, rect.top - padding);
            const left = Math.max(0, rect.left - padding);
            const right = Math.min(window.innerWidth, rect.right + padding);
            const bottom = Math.min(window.innerHeight, rect.bottom + padding);
            modalState.backdrop.style.setProperty('--autofill-spotlight-top', `${top}px`);
            modalState.backdrop.style.setProperty('--autofill-spotlight-left', `${left}px`);
            modalState.backdrop.style.setProperty('--autofill-spotlight-width', `${Math.max(0, right - left)}px`);
            modalState.backdrop.style.setProperty('--autofill-spotlight-height', `${Math.max(0, bottom - top)}px`);
        };

        const queueSpotlightRefresh = () => {
            if (!(spotlightAnchor instanceof HTMLElement) || spotlightFrame !== null) {
                return;
            }

            spotlightFrame = window.requestAnimationFrame(() => {
                spotlightFrame = null;
                if (spotlightAnchor instanceof HTMLElement) {
                    setSpotlightForAnchor(spotlightAnchor);
                }
            });
        };

        const setLoadingState = (loading, message = '') => {
            isLoading = Boolean(loading);
            if (modalState.modal instanceof HTMLElement) {
                if (isLoading) {
                    modalState.modal.classList.add('is-loading');
                } else {
                    modalState.modal.classList.remove('is-loading');
                }
            }
            if (modalState.loading instanceof HTMLElement) {
                modalState.loading.hidden = !isLoading;
            }
            if (modalState.loadingText instanceof HTMLElement) {
                modalState.loadingText.textContent = String(message || 'Waiting for response from AI...');
            }
            if (modalState.body instanceof HTMLElement) {
                modalState.body.hidden = isLoading;
            }
            if (modalState.buttons instanceof HTMLElement) {
                modalState.buttons.hidden = isLoading;
            }
        };

        const showLoading = (message = 'Waiting for response from AI...') => {
            setLoadingState(true, message);
            show();
            if (modalState.status instanceof HTMLElement) {
                modalState.status.textContent = '';
            }
            if (modalState.errors instanceof HTMLElement) {
                modalState.errors.textContent = '';
                modalState.errors.hidden = true;
            }
            if (modalState.field instanceof HTMLElement) {
                modalState.field.textContent = '';
            }
            if (modalState.editor instanceof HTMLElement) {
                modalState.editor.innerHTML = '';
            }
            clearSpotlight();
        };

        const placeReviewPanel = (anchor) => {
            const gap = 12;
            const viewportPadding = 12;
            const rect = anchor.getBoundingClientRect();
            const availableHeight = Math.max(160, window.innerHeight - (viewportPadding * 2));
            modalState.modal.style.setProperty('--autofill-review-max-height', `${availableHeight}px`);

            const panel = modalState.modal.shadowRoot?.querySelector('dialog');
            const modalHeight = panel?.getBoundingClientRect().height || 320;
            const spaceBelow = window.innerHeight - rect.bottom - viewportPadding;
            const spaceAbove = rect.top - viewportPadding;
            const canFitBelow = spaceBelow >= modalHeight + gap;
            const canFitAbove = spaceAbove >= modalHeight + gap;
            const shouldPlaceAbove = !canFitBelow && (canFitAbove || spaceAbove > spaceBelow);
            const idealTop = shouldPlaceAbove
                ? rect.top - modalHeight - gap
                : rect.bottom + gap;
            const maxTop = window.innerHeight - modalHeight - viewportPadding;
            const computedTop = Math.max(viewportPadding, Math.min(idealTop, maxTop));
            modalState.modal.style.setProperty('--autofill-review-top', `${computedTop}px`);
        };

        const positionBelowField = (input) => {
            if (!(modalState.modal instanceof HTMLElement)) return;

            const anchor = runtime.getInteractionAnchor(input);
            if (input.closest('[data-autofill-runtime]')) {
                clearSpotlight();
            } else {
                spotlightAnchor = anchor;
                setSpotlightForAnchor(anchor);
            }
            if (!modalState.modal.classList.contains('is-inspecting')) placeReviewPanel(anchor);
        };

        const renderCurrent = () => {
            if (!suggestions.length) {
                teardown();
                return;
            }

            if (
                !(modalState.modal instanceof HTMLElement) ||
                !(modalState.status instanceof HTMLElement) ||
                !(modalState.field instanceof HTMLElement) ||
                !(modalState.editor instanceof HTMLElement)
            ) {
                return;
            }

            setLoadingState(false);
            show();
            const current = suggestions[currentIndex];
            correctionMade = false;
            const validationErrors = Array.isArray(current.validationErrors) ? current.validationErrors : [];
            const readonly = ['tablePreview', 'iconPreview', 'linkPreview'].includes(current?.reviewEditor?.type);
            const accept = modalState.modal.querySelector('[data-autofill-accept]');
            if (accept) {
                accept.disabled = validationErrors.length > 0 || !current.matchedHandle;
                accept.textContent = 'Accept';
            }
            const rawDetails = modalState.modal.querySelector('[data-autofill-review-raw]');
            const rawText = modalState.modal.querySelector('[data-autofill-review-raw-value]');
            if (rawDetails && rawText) {
                rawDetails.hidden = validationErrors.length === 0;
                rawDetails.open = validationErrors.length > 0;
                rawText.textContent = current.hasRawValue === false ? '(No value returned)' : JSON.stringify(Object.prototype.hasOwnProperty.call(current, 'rawValue') ? current.rawValue : current.value, null, 2);
            }
            const displayMode = current?.reviewEditor?.displayMode || '';
            setModalDisplayMode(displayMode);
            modalState.status.textContent = `${currentIndex + 1} of ${suggestions.length}`;
            modalState.field.textContent = current.displayFieldName || current.fieldName || '(Unmatched field)';
            if (modalState.errors instanceof HTMLElement) {
                if (validationErrors.length) {
                    modalState.errors.textContent = validationErrors.join(' ') + (readonly ? ' This result is read-only. Skip it or regenerate.' : ' Correct the value below, then check and apply.');
                    modalState.errors.hidden = false;
                } else if (current.applicationError) {
                    modalState.errors.textContent = 'Automatic application failed: ' + current.applicationError;
                    modalState.errors.hidden = false;
                } else {
                    modalState.errors.textContent = '';
                    modalState.errors.hidden = true;
                }
            }
            modalState.editor.hidden = readonly && validationErrors.length > 0;
            runtime.renderReviewEditor({
                suggestion: current,
                container: modalState.editor,
            });
            focusMatchedField(current.matchedHandle, {
                root: fieldRoot,
                positionReviewModal: positionBelowField,
            });
        };

        const allowCorrection = () => {
            const current = suggestions[currentIndex];
            if (!current || ['tablePreview', 'iconPreview', 'linkPreview'].includes(current?.reviewEditor?.type) || !current.matchedHandle) return;
            correctionMade = true;
            const accept = modalState.modal.querySelector('[data-autofill-accept]');
            if (accept) {
                accept.disabled = false;
                accept.textContent = current.validationErrors?.length ? 'Check & apply' : 'Accept';
            }
        };
        modalState.editor?.addEventListener('input', allowCorrection);
        modalState.editor?.addEventListener('change', allowCorrection);

        const clear = () => {
            suggestions = [];
            currentIndex = 0;
            teardown();
        };

        const setSuggestions = (nextSuggestions) => {
            setLoadingState(false);
            suggestions = Array.isArray(nextSuggestions) ? nextSuggestions : [];
            currentIndex = 0;
            if (suggestions.length) {
                renderCurrent();
                return;
            }
            teardown();
        };

        const showDecisionError = (message) => {
            if (!(modalState.errors instanceof HTMLElement)) return;
            modalState.errors.textContent = message;
            modalState.errors.hidden = false;
        };

        const handleDocumentClick = async (event) => {
            const target = event.target;
            if (!(target instanceof HTMLElement) || !(modalState.modal instanceof HTMLElement)) {
                return;
            }

            if (isLoading) {
                return;
            }

            const ownControl = (selector) => {
                const control = target.closest(selector);
                if (!(control instanceof HTMLElement)) {
                    return null;
                }

                return control.closest('[data-autofill-review-modal]') === modalState.modal
                    ? control
                    : null;
            };

            if (target === modalState.backdrop) {
                return;
            }

            if (ownControl('[data-autofill-close]')) {
                finishReview({ reloadPage: true });
                return;
            }

            if (ownControl('[data-autofill-inspect]')) {
                setInspecting(!modalState.modal.classList.contains('is-inspecting'));
                return;
            }

            if (ownControl('[data-autofill-reject]')) {
                const current = suggestions[currentIndex];
                if (!current) return;
                try {
                    if (rejectSuggestion) await rejectSuggestion(current);
                    suggestions.splice(currentIndex, 1);
                    if (!suggestions.length) finishReview({ reloadPage: true });
                    else { currentIndex = Math.min(currentIndex, suggestions.length - 1); renderCurrent(); }
                } catch (error) {
                    showDecisionError(error.message || 'Could not reject this result.');
                }
                return;
            }

            if (ownControl('[data-autofill-accept]')) {
                if (!suggestions.length || !(modalState.editor instanceof HTMLElement)) {
                    return;
                }
                const current = suggestions[currentIndex];
                const editorType = String(current?.reviewEditor?.type || '').trim();
                if (current.validationErrors?.length && (!correctionMade || ['tablePreview', 'iconPreview', 'linkPreview'].includes(editorType))) return;
                if (editorType !== 'tablePreview') {
                    current.value = runtime.readReviewEditorValue({
                        suggestion: current,
                        container: modalState.editor,
                    });
                }
                if (current.matchedHandle) {
                    try {
                        await applySuggestion({
                            ...current,
                            value: current.value,
                        });
                    } catch (error) {
                        showDecisionError(error.message || 'Suggestion could not be applied to the matched field.');
                        return;
                    }
                }
                if (currentIndex < suggestions.length - 1) {
                    currentIndex += 1;
                    renderCurrent();
                } else {
                    finishReview({ reloadPage: true });
                }
                return;
            }

            if (ownControl('[data-autofill-prev]')) {
                if (!suggestions.length) {
                    return;
                }
                currentIndex = Math.max(0, currentIndex - 1);
                renderCurrent();
                return;
            }

            if (ownControl('[data-autofill-next]')) {
                if (!suggestions.length) {
                    return;
                }
                currentIndex = Math.min(suggestions.length - 1, currentIndex + 1);
                renderCurrent();
            }
        };

        const destroy = () => {
            clear();
            document.removeEventListener('click', handleDocumentClick);
            window.removeEventListener('resize', queueSpotlightRefresh);
            document.removeEventListener('scroll', queueSpotlightRefresh, true);
            modalState.backdrop?.remove();
            modalState.modal?.remove();
        };

        return {
            clear,
            destroy,
            handleDocumentClick,
            positionBelowField,
            setSuggestions,
            showLoading,
            refreshSpotlight: queueSpotlightRefresh,
        };
    };
})();
