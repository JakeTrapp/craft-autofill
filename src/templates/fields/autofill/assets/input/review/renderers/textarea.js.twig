    // Rich text from AI responses is untrusted. This is an allow-list: the input is parsed into an inert document,
    // then rebuilt node by node with document.createElement, copying only allowed tags and attributes. The output
    // never contains scripts, event handlers, styles, SVG, MathML, forms or unsafe URLs.
    const RICH_TEXT_ALLOWED_TAGS = new Set([
        'A', 'ABBR', 'B', 'BLOCKQUOTE', 'BR', 'CAPTION', 'CITE', 'CODE', 'DD', 'DEL', 'DIV', 'DL', 'DT', 'EM',
        'FIGCAPTION', 'FIGURE', 'H1', 'H2', 'H3', 'H4', 'H5', 'H6', 'HR', 'I', 'IMG', 'INS', 'LI', 'MARK', 'OL', 'P',
        'PRE', 'Q', 'S', 'SMALL', 'SPAN', 'STRIKE', 'STRONG', 'SUB', 'SUP', 'TABLE', 'TBODY', 'TD', 'TFOOT', 'TH',
        'THEAD', 'TR', 'U', 'UL',
    ]);
    // Removed with everything inside them, rather than unwrapped.
    const RICH_TEXT_DROPPED_TAGS = new Set([
        'SCRIPT', 'STYLE', 'TEMPLATE', 'NOSCRIPT', 'IFRAME', 'FRAME', 'FRAMESET', 'OBJECT', 'EMBED', 'APPLET', 'SVG',
        'MATH', 'FORM', 'INPUT', 'BUTTON', 'TEXTAREA', 'SELECT', 'OPTION', 'LINK', 'META', 'BASE', 'TITLE', 'HEAD',
        'VIDEO', 'AUDIO', 'SOURCE', 'TRACK', 'CANVAS', 'PORTAL', 'DIALOG',
    ]);
    const RICH_TEXT_ALLOWED_ATTRIBUTES = {
        A: ['href', 'title'],
        IMG: ['src', 'alt', 'title', 'width', 'height'],
        TD: ['colspan', 'rowspan'],
        TH: ['colspan', 'rowspan', 'scope'],
        OL: ['start', 'reversed'],
        ABBR: ['title'],
        Q: ['cite'],
        BLOCKQUOTE: ['cite'],
    };
    const RICH_TEXT_URL_ATTRIBUTES = new Set(['href', 'src', 'cite']);
    const RICH_TEXT_SAFE_IMAGE_DATA = /^data:image\/(?:png|jpe?g|gif|webp|avif);base64,[a-z0-9+/=\s]+$/i;

    const isSafeRichTextUrl = (value, attribute) => {
        // Browsers ignore control characters and whitespace inside schemes, so strip them before checking.
        const url = String(value).replace(/[\u0000-\u0020\u007f-\u009f]/g, '');
        if (url === '') return false;
        if (attribute === 'src' && RICH_TEXT_SAFE_IMAGE_DATA.test(String(value).trim())) return true;
        const scheme = url.match(/^([a-z][a-z0-9+.-]*):/i);
        if (!scheme) return true;
        return ['http', 'https', 'mailto', 'tel'].includes(scheme[1].toLowerCase());
    };

    const copyRichTextNode = (source, depth) => {
        if (source.nodeType === Node.TEXT_NODE) return document.createTextNode(source.nodeValue || '');
        if (source.nodeType !== Node.ELEMENT_NODE || depth > 64) return null;
        const tag = source.tagName.toUpperCase();
        if (RICH_TEXT_DROPPED_TAGS.has(tag) || source.namespaceURI !== 'http://www.w3.org/1999/xhtml') return null;

        const children = document.createDocumentFragment();
        for (const child of Array.from(source.childNodes)) {
            const copy = copyRichTextNode(child, depth + 1);
            if (copy) children.appendChild(copy);
        }
        // Unknown but harmless elements are unwrapped so their text stays readable.
        if (!RICH_TEXT_ALLOWED_TAGS.has(tag)) return children;

        const element = document.createElement(tag.toLowerCase());
        // Class names can't run code, and rich text editors such as CKEditor use them for alignment and styles.
        for (const name of [...(RICH_TEXT_ALLOWED_ATTRIBUTES[tag] || []), 'class']) {
            if (!source.hasAttribute(name)) continue;
            const value = source.getAttribute(name) || '';
            if (RICH_TEXT_URL_ATTRIBUTES.has(name) && !isSafeRichTextUrl(value, name)) continue;
            element.setAttribute(name, value);
        }
        if (tag === 'A' && element.hasAttribute('href')) {
            element.setAttribute('rel', 'noopener noreferrer nofollow');
            element.setAttribute('target', '_blank');
        }
        element.appendChild(children);
        return element;
    };

    const sanitizeRichTextFragment = (rawValue) => {
        const fragment = document.createDocumentFragment();
        const input = asString(rawValue);
        if (input.trim() === '') return fragment;
        // DOMParser documents are inert: scripts don't run and images don't load.
        const parsed = new DOMParser().parseFromString(input, 'text/html');
        for (const child of Array.from(parsed.body.childNodes)) {
            const copy = copyRichTextNode(child, 0);
            if (copy) fragment.appendChild(copy);
        }
        return fragment;
    };

    const sanitizeRichTextHtml = (rawValue) => {
        const container = document.createElement('div');
        container.appendChild(sanitizeRichTextFragment(rawValue));
        return container.innerHTML.trim();
    };

    const createTextareaRenderer = () => ({
        render({ suggestion, editorConfig, container }) {
            const isRichText = String(editorConfig?.displayMode || '').trim().toLowerCase() === 'richtext';
            const isJson = String(editorConfig?.displayMode || '').trim().toLowerCase() === 'json';
            if (isRichText) {
                container.innerHTML = '';
                const editor = document.createElement('div');
                editor.className = 'autofill-review-richtext-editor text fullwidth';
                editor.setAttribute('contenteditable', 'true');
                editor.setAttribute('spellcheck', 'true');
                editor.dataset.autofillReviewInput = 'richtext';
                editor.replaceChildren(sanitizeRichTextFragment(suggestion.value ?? ''));
                container.appendChild(editor);
                return;
            }

            const usedTemplate = mountTemplate('textarea', container);
            const textarea = usedTemplate
                ? container.querySelector('[data-autofill-review-input="textarea"]')
                : (() => {
                    const element = document.createElement('textarea');
                    element.className = 'text fullwidth';
                    element.rows = 3;
                    container.appendChild(element);
                    return element;
                })();
            if (!(textarea instanceof HTMLTextAreaElement)) {
                return;
            }
            textarea.rows = isJson ? 10 : 3;
            textarea.value = asString(suggestion.value ?? '');
        },
        readValue({ container }) {
            const richText = container.querySelector('[data-autofill-review-input="richtext"]');
            if (richText instanceof HTMLElement) {
                return sanitizeRichTextHtml(richText.innerHTML);
            }

            const textarea = container.querySelector('[data-autofill-review-input="textarea"], textarea');
            return textarea instanceof HTMLTextAreaElement ? textarea.value : '';
        },
    });
