{% include 'autofill/cp/_request.js.twig' %}
(() => {
    // Server communication for prompt previews and response normalization.
    window.AutofillInputRuntime = window.AutofillInputRuntime || {};
    const runtime = window.AutofillInputRuntime;

    const { postJson } = runtime;

    runtime.buildPromptPreview = async ({ endpoint, workflowHandle, userPrompt, elementId, siteId }) => {
        const data = await postJson(
            endpoint,
            { userPrompt, workflowHandle, elementId, siteId },
            'Could not build prompt preview.',
        );

        return String(data.prompt || '');
    };

    runtime.normalizeResponse = async ({ endpoint, workflowHandle, rawResponse, elementId, siteId }) => {
        const data = await postJson(
            endpoint,
            { rawResponse, workflowHandle, elementId, siteId },
            'Could not normalize response.',
        );

        return Array.isArray(data.suggestions) ? data.suggestions : [];
    };

    runtime.generateSuggestions = async ({ endpoint, workflowHandle, userPrompt, elementId, siteId }) => {
        const data = await postJson(
            endpoint,
            { userPrompt, workflowHandle, elementId, siteId },
            'Could not generate suggestions.',
        );

        return Array.isArray(data.suggestions) ? data.suggestions : [];
    };

    runtime.applySuggestionViaServer = async ({ endpoint, workflowHandle, elementId, siteId, suggestion }) => {
        const data = await postJson(
            endpoint,
            { workflowHandle, elementId, siteId, suggestion },
            'Could not apply suggestion.',
        );

        return data.applied || null;
    };

    runtime.runRequest = async (endpoint, payload) => postJson(endpoint, payload, 'Could not update the Autofill run.');

    runtime.fetchIconSvg = async ({ endpoint, icon }) => {
        const data = await postJson(
            endpoint,
            { icon },
            'Could not load icon preview.',
        );

        return String(data.iconSvg || '');
    };
})();
