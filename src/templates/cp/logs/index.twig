{% extends '_layouts/cp.twig' %}
{% set title = 'Autofill Logs'|t('autofill') %}
{% set selectedSubnavItem = 'logs' %}
{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') %}

{% block content %}
    <div id="autofill-logs-admin-table"></div>
{% endblock %}

{% js %}
    new Craft.VueAdminTable({
        container: '#autofill-logs-admin-table',
        columns: [
            {name: 'id', title: {{ 'ID'|t('app')|json_encode|raw }}, sortField: true, callback: Craft.escapeHtml},
            {name: 'dateCreated', title: {{ 'Date'|t('app')|json_encode|raw }}, sortField: true, callback: Craft.escapeHtml},
            {name: 'success', title: {{ 'Status'|t('app')|json_encode|raw }}, sortField: true, callback: value => '<span class="status ' + (value ? 'enabled' : 'disabled') + '"></span>' + Craft.escapeHtml(Craft.t('app', value ? 'Success' : 'Failed'))},
            {name: 'fieldId', title: {{ 'Field'|t('app')|json_encode|raw }}, sortField: true, callback: Craft.escapeHtml},
            {name: 'entryId', title: {{ 'Entry'|t('app')|json_encode|raw }}, sortField: true, callback: Craft.escapeHtml},
            {name: 'siteId', title: {{ 'Site'|t('app')|json_encode|raw }}, sortField: true, callback: Craft.escapeHtml},
            {name: 'userId', title: {{ 'User'|t('app')|json_encode|raw }}, sortField: true, callback: Craft.escapeHtml},
            {name: 'provider', title: {{ 'Provider'|t('autofill')|json_encode|raw }}, sortField: true, callback: Craft.escapeHtml},
            {name: 'modelId', title: {{ 'Model'|t('autofill')|json_encode|raw }}, sortField: true, callback: Craft.escapeHtml},
            {name: 'latencyMs', title: {{ 'Latency'|t('autofill')|json_encode|raw }}, sortField: true, callback: Craft.escapeHtml},
            {name: 'totalTokens', title: {{ 'Tokens'|t('autofill')|json_encode|raw }}, sortField: true, callback: Craft.escapeHtml},
            {name: '__slot:detail', title: {{ 'Details'|t('app')|json_encode|raw }}},
        ],
        tableDataEndpoint: 'autofill/logs/table-data',
        perPage: 50,
        search: true,
        emptyMessage: {{ 'No Autofill logs have been recorded yet.'|t('autofill')|json_encode|raw }},
        itemLabels: {singular: {{ 'log'|t('autofill')|json_encode|raw }}, plural: {{ 'logs'|t('autofill')|json_encode|raw }}},
    });
{% endjs %}
