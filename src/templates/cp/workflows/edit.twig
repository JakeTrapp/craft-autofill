{% extends '_layouts/cp.twig' %}
{% set title = workflow.id ? 'Edit Workflow'|t('autofill') : 'New Workflow'|t('autofill') %}
{% set selectedSubnavItem = 'workflows' %}
{% do view.registerAssetBundle('jtdev\\craftautofill\\web\\assets\\cp\\AutofillCpAsset') %}
{% set options = {
    screen: 'editor', workflow: workflow, entryTypes: entryTypes, volumes: volumes, modelConfigs: modelConfigs,
    listUrl: url('autofill/workflows'),
    editUrl: workflow.handle ? url('autofill/workflows/edit/' ~ workflow.handle) : url('autofill/workflows/new'),
    fieldsUrl: actionUrl('autofill/workflows/fields'),
    saveUrl: actionUrl('autofill/workflows/save'),
} %}
{% block content %}
    <div data-autofill-vue-root data-screen="editor" data-options="{{ options|json_encode|e('html_attr') }}"></div>
{% endblock %}
