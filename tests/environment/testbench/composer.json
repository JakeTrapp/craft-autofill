{
  "name": "jt-dev/craft-autofill-testbench",
  "description": "Disposable Craft 5 site and integration runtime for Autofill.",
  "private": true,
  "require": {
    "php": ">=8.2",
    "craftcms/ckeditor": "^4.0",
    "craftcms/cms": "^5.12.1",
    "jt-dev/craft-autofill": "@dev",
    "nystudio107/craft-seomatic": "^5.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "codeception/codeception": "^5.2",
    "codeception/module-asserts": "^3.0",
    "codeception/module-datafactory": "^3.0",
    "codeception/module-yii2": "^1.1.9"
  },
  "repositories": [
    {"type": "path", "url": "..", "options": {"symlink": true}}
  ],
  "autoload": {
    "psr-4": {"modules\\autofilltestbench\\": "modules/autofilltestbench/src/"}
  },
  "autoload-dev": {
    "psr-4": {"Tests\\Support\\": "../tests/fixtures/Support/"}
  },
  "config": {
    "allow-plugins": {"craftcms/plugin-installer": true, "yiisoft/yii2-composer": true},
    "platform": {"php": "8.2"},
    "sort-packages": true
  }
}
