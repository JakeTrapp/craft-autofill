#!/usr/bin/env bash
# Runs Autofill's MCP tool tests against Craft's stdio MCP server in the DDEV testbench.
#
# Rebuilds the marked, disposable db_test database (never the manual site database), installs Craft and Autofill,
# seeds the browser fixtures (an admin, a workflow manager, an editor without Autofill access, and a workflow with an
# automatic output), then runs tests/mcp/test_agent_tools.py. Requires Craft 5.12 or later in the testbench.
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_dir"

lock_dir="$repo_dir/testbench/.test-run.lock"
if ! mkdir "$lock_dir" 2>/dev/null; then
  printf '%s\n' 'Another Autofill test suite owns db_test. Wait for it to finish before starting this suite.' >&2
  exit 1
fi
printf 'mcp pid %s\n' "$$" > "$lock_dir/owner"
trap 'rm -f "$lock_dir/owner"; rmdir "$lock_dir" 2>/dev/null || true' EXIT

testbench/bin/materialize >/dev/null
ddev start >/dev/null

# The fixture provider needs Autofill installed, so it's only switched on after installation.
install_in_test_db() {
  ddev exec -d /var/www/html/testbench env CRAFT_DB_DATABASE=db_test "$@"
}
in_test_db() {
  ddev exec -d /var/www/html/testbench env CRAFT_DB_DATABASE=db_test AUTOFILL_TEST_PROVIDER_FIXTURE=1 AUTOFILL_FIXTURE_API_KEY=fixture "$@"
}

ddev exec -d /var/www/html/testbench php bin/create-test-database.php
install_in_test_db php craft install --interactive=0 --username=admin --email=admin@example.test \
  --password=autofill-mcp-admin-password --site-name=Autofill --site-url='$PRIMARY_SITE_URL' --language=en-US >/dev/null
install_in_test_db php craft plugin/install autofill >/dev/null
install_in_test_db php /var/www/html/tests/mcp/prepare.php
fixture="$(in_test_db php craft autofill-testbench/seed/browser | grep '^{' | tail -1)"
if [[ -z "$fixture" ]]; then
  printf '%s\n' 'The fixture seed did not return JSON.' >&2
  exit 1
fi

AUTOFILL_MCP_FIXTURE="$fixture" CRAFT_DB_DATABASE=db_test AUTOFILL_TEST_PROVIDER_FIXTURE=1 \
  python3 -m unittest -v tests/mcp/test_agent_tools.py "$@"
