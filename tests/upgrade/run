#!/usr/bin/env bash
set -euo pipefail
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_dir"
lock_dir="$repo_dir/testbench/.test-run.lock"
if ! mkdir "$lock_dir" 2>/dev/null; then
  printf '%s\n' 'Another Autofill test suite owns db_test. Wait for it to finish.' >&2
  exit 1
fi
printf 'upgrade pid %s\n' "$$" > "$lock_dir/owner"
trap 'rm -f "$lock_dir/owner"; rmdir "$lock_dir" 2>/dev/null || true' EXIT
testbench/bin/materialize
mkdir -p testbench/.upgrade-legacy
git archive 1.0.7 src composer.json | tar -x -C testbench/.upgrade-legacy
ddev start
ddev composer install --no-interaction
ddev exec -d /var/www/html/testbench vendor/bin/codecept build -c upgrade-legacy.yml
for edition in lite pro; do
  printf 'Rehearsing 1.0.7 upgrade: %s\n' "$edition"
  ddev exec -d /var/www/html/testbench php bin/create-test-database.php
  ddev exec -d /var/www/html/testbench env AUTOFILL_UPGRADE_EDITION="$edition" AUTOFILL_UPGRADE_STAGE=legacy vendor/bin/codecept run upgrade -c upgrade-legacy.yml
  ddev exec -d /var/www/html/testbench env AUTOFILL_UPGRADE_EDITION="$edition" AUTOFILL_UPGRADE_STAGE=current vendor/bin/codecept run upgrade -c upgrade-current.yml
done
