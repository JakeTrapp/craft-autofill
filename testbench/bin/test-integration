#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_dir"

lock_dir="$repo_dir/testbench/.test-run.lock"
if ! mkdir "$lock_dir" 2>/dev/null; then
  printf '%s\n' 'Another Autofill test suite owns db_test. Wait for it to finish before starting this suite.' >&2
  exit 1
fi
printf 'integration pid %s\n' "$$" > "$lock_dir/owner"
trap 'rm -f "$lock_dir/owner"; rmdir "$lock_dir" 2>/dev/null || true' EXIT

testbench/bin/materialize
ddev start
ddev composer install --no-interaction
ddev exec -d /var/www/html/testbench php bin/create-test-database.php
ddev exec -d /var/www/html/testbench vendor/bin/codecept build
ddev exec -d /var/www/html/testbench vendor/bin/codecept run integration --skip-group live "$@"
